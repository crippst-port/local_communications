{{!
    @template local_communications/modal_footer

    Step-scoped action buttons for the feedback modal, rendered into the modal's
    dedicated footer region rather than inline in the body, for clearer spacing
    between content and actions. Each [data-step] group here is shown/hidden in
    lockstep with the matching body step by local_communications/app.js. Step 1 (the
    sentiment pick) has no footer group - picking a face advances the modal by
    itself, so the footer stays empty there.
}}
<div class="local-communications__footer-step" data-step="2" hidden="hidden">
    <button type="button" class="btn btn-secondary" data-action="category-back"></button>
    <button type="button" class="btn btn-secondary" data-action="category-skip"></button>
    <button type="button" class="btn btn-primary" data-action="category-other-continue" hidden="hidden" disabled="disabled"></button>
</div>

<div class="local-communications__footer-step" data-step="3" hidden="hidden">
    <button type="button" class="btn btn-secondary" data-action="back"></button>
    <button type="button" class="btn btn-primary" data-action="submit"></button>
</div>

<div class="local-communications__footer-step" data-step="4" hidden="hidden">
    <button type="button" class="btn btn-primary" data-action="close"></button>
</div>
