{{!
    @template local_communications/modal_body

    The four-step body of the course feedback modal: choose a sentiment, optionally
    say which area it's about (from the admin-configured list, or free text via
    "Other"), write a comment, then a confirmation screen. Step navigation buttons
    live in local_communications/modal_footer, not here - see that template. Steps are
    shown/hidden together (body + footer) by local_communications/app.js.

    Context variables:
    * categories - array of {value} - the admin-configured area buttons to render
}}
<div class="local-communications__modal">

    <div class="local-communications__step" data-step="1">
        <p class="local-communications__intro" data-role="intro" hidden="hidden"></p>
        <div class="local-communications__sentiments">
            <button type="button" class="local-communications__sentiment" data-sentiment="happy">
                <span class="local-communications__sentiment-icon" aria-hidden="true">&#128522;</span>
                <span class="local-communications__sentiment-label" data-role="label-happy"></span>
            </button>
            <button type="button" class="local-communications__sentiment" data-sentiment="neutral">
                <span class="local-communications__sentiment-icon" aria-hidden="true">&#128528;</span>
                <span class="local-communications__sentiment-label" data-role="label-neutral"></span>
            </button>
            <button type="button" class="local-communications__sentiment" data-sentiment="sad">
                <span class="local-communications__sentiment-icon" aria-hidden="true">&#128542;</span>
                <span class="local-communications__sentiment-label" data-role="label-sad"></span>
            </button>
        </div>
        <p class="local-communications__neverask">
            <span data-role="neverask-prefix"></span><button
                type="button"
                class="local-communications__neverask-link"
                data-action="neverask"
                data-role="neverask-linktext"
            ></button>
        </p>
    </div>

    <div class="local-communications__step" data-step="2" hidden="hidden">
        <p class="local-communications__prompt" data-role="category-heading"></p>
        <div class="local-communications__categories">
            {{#categories}}
            <button type="button" class="local-communications__category" data-category="{{value}}">{{value}}</button>
            {{/categories}}
            <button type="button" class="local-communications__category local-communications__category--other" data-action="category-other">
                <span data-role="category-label-other"></span>
            </button>
        </div>
        <div class="local-communications__category-other" data-role="category-other-wrap" hidden="hidden">
            <input type="text" class="local-communications__input" data-role="category-other-text" maxlength="255">
        </div>
    </div>

    <div class="local-communications__step" data-step="3" hidden="hidden">
        <p class="local-communications__prompt" data-role="prompt"></p>
        <textarea
            class="local-communications__textarea"
            data-role="feedbacktext"
            rows="4"
        ></textarea>
        <div class="local-communications__error" data-role="error" hidden="hidden"></div>
        <div class="local-communications__anonymous">
            <input type="checkbox" id="local-communications-anonymous" data-role="anonymous">
            <label for="local-communications-anonymous" data-role="anonymous-label"></label>
        </div>
    </div>

    <div class="local-communications__step" data-step="4" hidden="hidden">
        <div class="local-communications__thankyou">
            <p class="local-communications__thankyou-title" data-role="thankyou-title"></p>
            <p class="local-communications__thankyou-body" data-role="thankyou-body"></p>
        </div>
    </div>

</div>
